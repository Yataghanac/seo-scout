# Copy to .env and fill in. Everything is optional; without OPENAI_API_KEY the tool
# runs the deterministic audit only and prints a warning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
SEO_SCOUT_DB=seo_scout.db
SEO_SCOUT_MAX_PAGES=500
SEO_SCOUT_MAX_DEPTH=5
SEO_SCOUT_MIN_DELAY=0.5
SEO_SCOUT_MAX_CONCURRENCY=2
SEO_SCOUT_MAX_COST_USD=1.00
SLACK_WEBHOOK_URL=
